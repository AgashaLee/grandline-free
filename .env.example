# Copy to .env to override defaults. Nothing here is required in Phase 1.

# --- the single switch that changes data source ---
PRICE_PROVIDER=optcg
# PRICE_PROVIDER=tcgapi     # Phase 2: paid provider

# Only needed once a paid provider is added.
# PROVIDER_API_KEY=

# --- caching ---
CACHE_TTL_HOURS=24
CACHE_FILE=cache.json

# --- currency ---
# The currency the whole portfolio is REPORTED in. Prices arrive in the
# source's own currency (JPY from Yuyu-tei, USD from optcgapi) and are
# converted into this one. Try USD, EUR, SGD, MYR, PHP, GBP, AUD...
DISPLAY_CURRENCY=IDR

# --- exchange rate ---
FX_SOURCE=er_api
# {base} is filled in per source currency, so each one gets its own rate.
FX_API_URL=https://open.er-api.com/v6/latest/{base}

# --- files ---
COLLECTION_FILE=collection.csv
PORTFOLIO_FILE=portfolio.csv

HTTP_TIMEOUT_SECONDS=15
